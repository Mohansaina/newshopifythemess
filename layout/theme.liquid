<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    {{ page_title }}{% if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
  </title>
  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}
  <link rel="canonical" href="{{ canonical_url }}">

  <!-- Fonts & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;500;600&family=Inter:wght@400;600&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">

  <!-- Tailwind CSS CDN & Config -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "primary": "#785918",
            "primary-container": "#c8a25a",
            "surface-tint": "#785918",
            "surface": "#fff8f3",
            "background": "#fff8f3",
            "on-background": "#1e1b16",
            "on-surface": "#1e1b16",
            "on-surface-variant": "#4e4639",
            "surface-container-low": "#fbf2e9",
            "surface-container": "#f5ece4",
            "surface-container-high": "#efe7de",
            "surface-container-lowest": "#ffffff",
            "on-primary": "#ffffff",
            "on-secondary-fixed": "#1c1b1b",
            "outline": "#807667",
            "outline-variant": "#d1c5b4",
            "secondary-container": "#e2dfde"
          },
          borderRadius: {
            "DEFAULT": "0.25rem",
            "lg": "0.5rem",
            "xl": "0.75rem",
            "full": "9999px"
          },
          spacing: {
            "margin-tablet": "40px",
            "margin-mobile": "20px",
            "gutter": "32px",
            "container-max": "1440px",
            "unit": "8px",
            "margin-desktop": "80px"
          },
          fontFamily: {
            "body-md": ["Inter", "sans-serif"],
            "headline-md": ["EB Garamond", "serif"],
            "label-caps": ["Inter", "sans-serif"],
            "display-lg": ["EB Garamond", "serif"],
            "body-lg": ["Inter", "sans-serif"],
            "headline-lg": ["EB Garamond", "serif"],
            "display-lg-mobile": ["EB Garamond", "serif"],
            "quote": ["EB Garamond", "serif"]
          },
          fontSize: {
            "body-md": ["16px", { lineHeight: "24px", fontWeight: "400" }],
            "headline-md": ["32px", { lineHeight: "40px", fontWeight: "400" }],
            "label-caps": ["12px", { lineHeight: "16px", letterSpacing: "0.1em", fontWeight: "600" }],
            "display-lg": ["64px", { lineHeight: "72px", letterSpacing: "-0.02em", fontWeight: "400" }],
            "body-lg": ["18px", { lineHeight: "28px", fontWeight: "400" }],
            "headline-lg": ["48px", { lineHeight: "56px", fontWeight: "400" }],
            "display-lg-mobile": ["40px", { lineHeight: "48px", letterSpacing: "-0.01em", fontWeight: "400" }],
            "quote": ["24px", { lineHeight: "36px", fontWeight: "400" }]
          }
        }
      }
    }
  </script>

  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="bg-background font-body-md text-on-background antialiased">
  {% section 'header' %}

  <main id="MainContent" class="w-full pt-20" role="main">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}
</body>
</html>

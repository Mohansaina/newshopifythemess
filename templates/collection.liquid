<div class="max-w-container-max mx-auto px-margin-mobile lg:px-margin-desktop py-16">
  <div class="text-center mb-12">
    <h1 class="font-headline-lg text-headline-lg text-on-surface mb-4">{{ collection.title }}</h1>
    {% if collection.description != blank %}
      <div class="font-body-lg text-on-surface-variant max-w-2xl mx-auto">
        {{ collection.description }}
      </div>
    {% endif %}
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-16">
    {% for product in collection.products %}
      <div class="group flex flex-col">
        <div class="relative w-full aspect-[4/5] rounded-2xl overflow-hidden bg-surface-container mb-6">
          <a href="{{ product.url }}">
            <img class="absolute inset-0 w-full h-full object-cover opacity-100 group-hover:opacity-0 transition-opacity duration-500"
                 src="{{ product.featured_image | image_url: width: 600 }}"
                 alt="{{ product.title | escape }}">
            {% if product.images[1] != blank %}
              <img class="absolute inset-0 w-full h-full object-cover opacity-0 group-hover:opacity-100 transition-opacity duration-500 group-hover:scale-105"
                   src="{{ product.images[1] | image_url: width: 600 }}"
                   alt="{{ product.title | escape }}">
            {% else %}
              <img class="absolute inset-0 w-full h-full object-cover opacity-0 group-hover:opacity-100 transition-opacity duration-500 group-hover:scale-105"
                   src="{{ product.featured_image | image_url: width: 600 }}"
                   alt="{{ product.title | escape }}">
            {% endif %}
          </a>
          <button class="absolute top-4 right-4 h-10 w-10 rounded-full bg-surface/80 backdrop-blur flex items-center justify-center text-on-surface-variant hover:text-primary hover:bg-surface transition-all shadow-sm z-10" aria-label="Wishlist">
            <span class="material-symbols-outlined text-[20px]">favorite</span>
          </button>
          <div class="absolute bottom-0 left-0 w-full p-4 translate-y-full group-hover:translate-y-0 transition-transform duration-300 z-10">
            <form action="/cart/add" method="post" enctype="multipart/form-data">
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <button type="submit" class="w-full bg-on-secondary-fixed/90 backdrop-blur text-on-primary font-label-caps text-label-caps py-3 rounded-lg hover:bg-on-secondary-fixed transition-colors">
                ADD TO CART
              </button>
            </form>
          </div>
        </div>
        <div class="flex flex-col flex-1">
          <h3 class="font-headline-md text-[20px] leading-[28px] text-on-surface mb-2">
            <a href="{{ product.url }}">{{ product.title }}</a>
          </h3>
          <p class="font-body-md text-on-surface-variant mb-3">{{ product.type }}</p>
          <p class="font-body-md text-on-surface mt-auto font-medium">{{ product.price | money }}</p>
        </div>
      </div>
    {% else %}
      <p class="col-span-full text-center text-on-surface-variant py-12">No products found in this collection.</p>
    {% endfor %}
  </div>
</div>

          <div class="relative w-full aspect-[4/5] rounded-2xl overflow-hidden bg-surface-container mb-6">
            <img class="absolute inset-0 w-full h-full object-cover opacity-100 group-hover:opacity-0 transition-opacity duration-500" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDuyQbGlgkYfTBe8iLJgPfhyLrt5e_flchpRa9kylTHL-6RBglmD9tv-UotMXL7ncUDKRpLygp1LBSomtejykDhWJpXfXeF5alnmRHF4Tad8z8t6oIOBytPexGWLjG42VescLo_-GGUvTPb1QVkn75Hfl8981Sf6pvNSy0xIJLh23UBNsTNG594kwTuCPEfQEVXV8m_YNfpluvAeCtlU1Ms35dBVSoQAbOmCJSBmavBX-GH71e7Qok" alt="Aura Pendant">

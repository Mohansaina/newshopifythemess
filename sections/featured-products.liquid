    <div class="mt-16 flex justify-center">
      <a href="{{ selected_collection.url | default: '/collections/all' }}" class="bg-transparent border border-outline text-on-surface font-label-caps text-label-caps py-4 px-12 rounded-lg hover:border-on-surface transition-colors duration-300 inline-block">
        {{ section.settings.button_label | default: 'VIEW ALL NEW ARRIVALS' }}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "LATEST ADDITIONS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Arrivals"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Shopify Collection"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "VIEW ALL NEW ARRIVALS"
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}

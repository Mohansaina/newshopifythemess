            <button class="absolute top-4 right-4 h-10 w-10 rounded-full bg-surface/80 backdrop-blur flex items-center justify-center text-on-surface-variant hover:text-primary hover:bg-surface transition-all shadow-sm z-10">
              <span class="material-symbols-outlined text-[20px]">favorite</span>

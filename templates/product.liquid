<div class="max-w-container-max mx-auto px-margin-mobile lg:px-margin-desktop py-16">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20">
    <div class="flex flex-col gap-4">
      <div class="w-full aspect-[4/5] rounded-2xl overflow-hidden bg-surface-container">
        <img src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.title | escape }}" class="w-full h-full object-cover" width="1200" height="1500">
      </div>
      {% if product.images.size > 1 %}
        <div class="grid grid-cols-4 gap-4">
          {% for img in product.images %}
            <div class="aspect-square rounded-xl overflow-hidden bg-surface-container cursor-pointer">
              <img src="{{ img | image_url: width: 300 }}" alt="{{ product.title | escape }}" class="w-full h-full object-cover" width="300" height="375">
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="flex flex-col">
      <span class="font-label-caps text-label-caps text-primary tracking-widest block mb-3 uppercase">{{ product.type | default: 'HAUTE JOAILLERIE' }}</span>
      <h1 class="font-headline-lg text-headline-lg text-on-surface mb-4">{{ product.title }}</h1>
      <p class="font-headline-md text-2xl text-on-surface mb-6 font-medium">{{ product.price | money }}</p>
      
      <div class="w-full h-px bg-outline-variant mb-8"></div>

      <div class="font-body-lg text-on-surface-variant mb-8 leading-relaxed">
        {{ product.description }}
      </div>

      <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="flex flex-col gap-4 mb-8">
        {% if product.has_only_default_variant == false %}
          <div class="flex flex-col gap-2">
            <label class="font-label-caps text-label-caps text-on-surface">Variant</label>
            <select name="id" class="bg-surface rounded-xl border border-outline-variant px-4 py-3 font-body-md text-on-surface focus:outline-none focus:border-primary">
              {% for variant in product.variants %}
                <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>
                  {{ variant.title }} - {{ variant.price | money }}
                </option>
              {% endfor %}
            </select>
          </div>
        {% else %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {% endif %}

        <button type="submit" class="bg-on-secondary-fixed text-on-primary font-label-caps text-label-caps py-5 px-8 rounded-xl hover:bg-surface-tint transition-colors duration-300 shadow-md text-center">
          ADD TO CART &bull; {{ product.price | money }}
        </button>
      </form>

      <div class="flex items-center gap-8 py-6 border-t border-b border-outline-variant">
        <div class="flex items-center gap-3">
          <span class="material-symbols-outlined text-primary">local_shipping</span>
          <span class="font-body-md text-sm text-on-surface-variant">Complimentary Insured Shipping</span>
        </div>
        <div class="flex items-center gap-3">
          <span class="material-symbols-outlined text-primary">verified</span>
          <span class="font-body-md text-sm text-on-surface-variant">Certificate of Authenticity</span>
        </div>
      </div>
    </div>
  </div>
</div>
